# Copy to apps/web/.env and fill in before running `vite build`.

# Founder application form endpoint (Step 8: form service).
# The form POSTs JSON with `Accept: application/json`, which Formspree accepts
# directly, e.g. https://formspree.io/f/abcdwxyz
# Leave empty to fall back to opening a pre-filled email to founders@vaultalpha.fund.
VITE_FOUNDER_APPLICATION_ENDPOINT=
